<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash icon: the system draws this in a 288dp box masked to a
     192dp circle; a 25% inset keeps the whole 144dp rounded icon visible. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/splash_logo"
    android:inset="25%" />
